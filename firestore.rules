rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /users/{discordId} {
      allow read: if true;
      allow create, update, delete: if isValidId(discordId);
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isValidId(announcementId);
    }

    match /schedules/{scheduleId} {
      allow read: if true;
      allow create, update, delete: if isValidId(scheduleId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
