{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student profile for Hufflepuff Hogworlds member",
      "type": "object",
      "properties": {
        "discordId": {
          "type": "string",
          "description": "Discord Snowflake user ID"
        },
        "name": {
          "type": "string",
          "description": "RP Character Name"
        },
        "studentId": {
          "type": "string",
          "description": "6-digit Hogwarts student ID"
        },
        "year": {
          "type": "number",
          "description": "Academic year 1 to 7"
        },
        "houseRole": {
          "type": "string",
          "description": "Primary house role"
        },
        "houseRoles": {
          "type": "array",
          "description": "List of all assigned house roles"
        },
        "characterPhoto": {
          "type": "string",
          "description": "Character photo URL"
        },
        "discordUsername": {
          "type": "string",
          "description": "Discord username"
        },
        "discordAvatar": {
          "type": "string",
          "description": "Discord avatar URL"
        },
        "joinedDate": {
          "type": "string",
          "description": "Date joined the house"
        },
        "bio": {
          "type": "string",
          "description": "Short character biography"
        },
        "pointsContributed": {
          "type": "number",
          "description": "House points earned"
        },
        "possessedSpells": {
          "type": "array",
          "description": "List of possessed spell names"
        }
      },
      "required": ["discordId", "name", "studentId", "year", "houseRole"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "House announcement for Hufflepuff Common Room",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Announcement ID"
        },
        "title": {
          "type": "string",
          "description": "Announcement title"
        },
        "date": {
          "type": "string",
          "description": "Date of announcement"
        },
        "author": {
          "type": "string",
          "description": "Author character name"
        },
        "authorRole": {
          "type": "string",
          "description": "Author house role"
        },
        "category": {
          "type": "string",
          "description": "Category: ข่าวสารสำคัญ, กิจกรรม, การเรียน, ฝึกซ้อม, อื่นๆ"
        },
        "content": {
          "type": "string",
          "description": "Announcement details"
        },
        "important": {
          "type": "boolean",
          "description": "Whether pinned as important"
        },
        "tags": {
          "type": "array",
          "description": "Tags associated with the announcement"
        }
      },
      "required": ["id", "title", "date", "author", "category", "content"]
    },
    "ScheduleEvent": {
      "title": "ScheduleEvent",
      "description": "House schedule event or meeting for Hufflepuff",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Event ID"
        },
        "title": {
          "type": "string",
          "description": "Event title"
        },
        "type": {
          "type": "string",
          "description": "Event type: ประชุมบ้าน, ฝึกซ้อม, อีเวนต์เซิร์ฟเวอร์, กิจกรรมบ้าน, อื่นๆ"
        },
        "date": {
          "type": "string",
          "description": "Date YYYY-MM-DD"
        },
        "time": {
          "type": "string",
          "description": "Time range e.g. 19:00 - 20:30 น."
        },
        "location": {
          "type": "string",
          "description": "Location in Hogwarts or server"
        },
        "professor": {
          "type": "string",
          "description": "Leader or Professor name"
        },
        "desc": {
          "type": "string",
          "description": "Description of the event"
        },
        "attendees": {
          "type": "number",
          "description": "Count of registered attendees"
        }
      },
      "required": ["id", "title", "type", "date", "time", "location"]
    }
  },
  "firestore": {
    "/users/{discordId}": {
      "schema": "UserProfile",
      "description": "Collection of registered student profiles indexed by Discord ID"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Collection of house announcements"
    },
    "/schedules/{scheduleId}": {
      "schema": "ScheduleEvent",
      "description": "Collection of house schedules and events"
    }
  }
}
